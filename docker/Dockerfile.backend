# ==============================================================================
# Production Dockerfile for Bright Mindz Academy Django Backend (Docker Compose)
# Build Context: ./backend
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app

WORKDIR ${APP_HOME}

# Install essential system dependencies for PostgreSQL, Pillow, and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg-dev \
    zlib1g-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt ${APP_HOME}/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . ${APP_HOME}/

# Ensure entrypoint is executable
RUN chmod +x ${APP_HOME}/entrypoint.sh

# Create static and media directories
RUN mkdir -p ${APP_HOME}/staticfiles ${APP_HOME}/media

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
