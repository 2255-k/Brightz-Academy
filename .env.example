# ==============================================================================
# BRIGHT MINDZ ACADEMY — ENVIRONMENT CONFIGURATION TEMPLATE
# Kochi, Kerala, India | https://www.brightmindzacademy.com
# ==============================================================================
# Copy this file to .env in backend/ and configure your real secrets.
# NEVER commit production .env or private credentials to version control.

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-in-production-brightmindz-2026
ALLOWED_HOSTS=localhost,127.0.0.1,brightmindzacademy.com,www.brightmindzacademy.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.brightmindzacademy.com

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL in Production, SQLite fallback in local dev)
# ------------------------------------------------------------------------------
# Set to 'postgres' to use PostgreSQL, or leave blank/sqlite for local SQLite
DB_ENGINE=sqlite
DB_NAME=brightmindz_db
DB_USER=brightmindz_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Alternatively, define DATABASE_URL:
# DATABASE_URL=postgres://brightmindz_user:your_secure_db_password@localhost:5432/brightmindz_db

# ------------------------------------------------------------------------------
# Business & WhatsApp Settings
# ------------------------------------------------------------------------------
ACADEMY_NAME=Bright Mindz Academy
ACADEMY_LOCATION=Kochi, Kerala, India
ACADEMY_DOMAIN=https://www.brightmindzacademy.com
# WhatsApp international format without '+' (e.g., 919846000000 for Kerala, India)
WHATSAPP_PHONE_NUMBER=919846000000
WHATSAPP_DEFAULT_MESSAGE=Hello Bright Mindz Academy, I would like to know more about your Spoken English courses.
SUPPORT_EMAIL=info@brightmindzacademy.com

# ------------------------------------------------------------------------------
# Payment Gateway Integration (Razorpay - Indian Rupee INR)
# ------------------------------------------------------------------------------
# Get your Test Keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
PAYMENT_CURRENCY=INR

# Optional Cashfree Payments Fallback
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ------------------------------------------------------------------------------
# Protected Video Streaming Integration
# ------------------------------------------------------------------------------
# Options: 'cloudflare', 'bunny', or 'mock' (for local development without cloud stream)
VIDEO_PROVIDER=mock

# Cloudflare Stream settings (when VIDEO_PROVIDER=cloudflare)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_PEM_KEY_ID=
CLOUDFLARE_STREAM_JWK_KEY=

# Bunny Stream settings (when VIDEO_PROVIDER=bunny)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bright Mindz Academy <no-reply@brightmindzacademy.com>

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (for frontend/.env)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
# VITE_WHATSAPP_PHONE_NUMBER=919846000000
